# Template: singleplayer.py fills in the paths using --install-dir or its default.
# For manual installation, replace @PYTHON@ and @INSTALL_DIR@ with absolute paths.
# launcher.py must be installed beside vkQuake.AppImage and the id1 directory.
# Use assets/icons/vkQuake.svg as the icon. Do not use ~ or $HOME in these paths.
# Copy the customized file to ~/.local/share/applications/ for the application menu.

[Desktop Entry]
Type=Application
Name=Quake Single Player (vkQuake Port)
Comment=Play Quake with vkQuake
Exec="@PYTHON@" "@INSTALL_DIR@/launcher.py"
Path=@INSTALL_DIR@
Icon=@INSTALL_DIR@/vkQuake.svg
TryExec=@PYTHON@
# Keep a terminal available for the initial setup wizard and launch errors.
Terminal=true
Categories=Game;ActionGame;
